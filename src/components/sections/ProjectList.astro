---
import type { CollectionEntry } from "astro:content";
import ProjectRow from "../ui/ProjectRow.astro";
import { translations, type Locale } from "../../data/i18n";

interface Props {
  projects: CollectionEntry<"projects" | "projectsZh">[];
  locale?: Locale;
}
const { projects, locale = "en" } = Astro.props;
const text = translations[locale].home;
---

<section class="section section--line">
  <div class="container">
    <div class="projects-head">
      <h2 class="section-heading">{text.projects}</h2><a
        class="text-link"
        href={locale === "zh" ? "/zh/projects" : "/projects"}>{text.allProjects}</a
      >
    </div>
    <div class="project-list">
      {
        projects.map((project) => (
          <ProjectRow
            description={project.data.description}
            href={`${locale === "zh" ? "/zh" : ""}/projects/${project.id}`}
            locale={locale}
            status={project.data.status}
            technologies={project.data.technologies}
            title={project.data.title}
          />
        ))
      }
    </div>
  </div>
</section>

<style>
  .projects-head {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    align-items: end;
    margin-bottom: 3.4rem;
  }
  .project-list {
    max-width: 100%;
  }
  @media (max-width: 720px) {
    .projects-head {
      align-items: start;
      flex-direction: column;
      margin-bottom: 2.2rem;
    }
  }
</style>
