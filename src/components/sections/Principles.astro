---
import { translations, type Locale } from "../../data/i18n";

interface Props {
  locale?: Locale;
  latestTitle?: string;
  latestHref?: string;
}

const { locale = "en", latestTitle, latestHref } = Astro.props;
const text = translations[locale].home;
---

<section class="principles">
  <div class="container">
    <h2 class="visually-hidden">{text.principlesTitle}</h2>
    <div class="principles__list">
      {
        text.principles.map(([title, copy], index) => (
          <article>
            <span aria-hidden="true" class="principles__icon">
              {index === 0 && (
                <svg fill="none" viewBox="0 0 32 32">
                  <rect
                    height="17"
                    rx="3"
                    stroke="currentColor"
                    stroke-width="1.7"
                    width="22"
                    x="5"
                    y="12"
                  />
                  <path
                    d="M10 12V9a6 6 0 0 1 12 0"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-width="1.7"
                  />
                </svg>
              )}
              {index === 1 && (
                <svg fill="none" viewBox="0 0 32 32">
                  <path
                    d="m11 7-8 9 8 9M21 7l8 9-8 9M19 3l-6 26"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.7"
                  />
                </svg>
              )}
              {index === 2 && (
                <svg fill="none" viewBox="0 0 32 32">
                  <path
                    d="M20.5 5.2a7 7 0 0 0-8.8 8.8L3.8 22a3.2 3.2 0 0 0 4.5 4.5l7.9-7.9a7 7 0 0 0 8.7-8.9l-4.3 4.2-3.7-1-1-3.7 4.6-4Z"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.7"
                  />
                </svg>
              )}
              {index === 3 && (
                <svg fill="none" viewBox="0 0 32 32">
                  <rect
                    height="18"
                    rx="2"
                    stroke="currentColor"
                    stroke-width="1.7"
                    width="18"
                    x="7"
                    y="7"
                  />
                  <rect
                    height="8"
                    rx="1"
                    stroke="currentColor"
                    stroke-width="1.7"
                    width="8"
                    x="12"
                    y="12"
                  />
                  <path
                    d="M11 3v4M16 3v4M21 3v4M11 25v4M16 25v4M21 25v4M3 11h4M3 16h4M3 21h4M25 11h4M25 16h4M25 21h4"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-width="1.7"
                  />
                </svg>
              )}
            </span>
            <div>
              <h3>{title}</h3>
              <p>{copy}</p>
            </div>
          </article>
        ))
      }
    </div>
    {
      latestTitle && latestHref && (
        <a class="latest" href={latestHref}>
          <span class="latest__signal" aria-hidden="true" />
          <span class="latest__label">{text.latestUpdate}</span>
          <strong>{latestTitle}</strong>
          <span class="latest__action">{text.readUpdate}</span>
          <svg aria-hidden="true" fill="none" height="18" viewBox="0 0 18 18" width="18">
            <path
              d="M3.5 9h11M10 4.5 14.5 9 10 13.5"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
            />
          </svg>
        </a>
      )
    }
  </div>
</section>

<style>
  .principles {
    padding: 0 0 0;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .principles__list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--line);
  }

  article {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: 1rem;
    min-width: 0;
    min-height: 7.25rem;
    padding: 1.35rem 1.5rem 1.45rem 0;
    border-right: 1px solid var(--line);
  }

  article + article {
    padding-left: 1.5rem;
  }

  article:last-child {
    border-right: 0;
  }

  .principles__icon {
    color: var(--accent);
  }

  .principles__icon svg {
    width: 3.25rem;
    height: 3.25rem;
  }

  h3 {
    font-family: var(--font-display);
    font-size: 0.98rem;
    font-weight: 620;
    letter-spacing: -0.005em;
    line-height: 1.3;
  }

  article p {
    margin-top: 0.35rem;
    color: var(--text-muted);
    font-size: 0.84rem;
    line-height: 1.48;
  }

  :global(html[lang="zh"]) h3 {
    letter-spacing: 0;
  }

  .latest {
    display: grid;
    grid-template-columns: auto auto auto auto;
    gap: 0.8rem;
    align-items: center;
    min-height: 5.25rem;
    border-top: 1px solid var(--line);
    color: var(--link);
    transition: color 160ms ease;
  }

  .latest:hover {
    color: var(--link-hover);
  }

  .latest__signal {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--accent);
  }

  .latest__label,
  .latest__action {
    color: var(--accent);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .latest__label {
    padding-right: 1.5rem;
    border-right: 1px solid var(--line);
  }

  .latest__action {
    display: none;
  }

  .latest strong {
    overflow: hidden;
    color: var(--text-muted);
    font-size: 0.92rem;
    font-weight: 520;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .latest svg {
    transition: transform 180ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .latest:hover svg {
    transform: translateX(3px);
  }

  @media (max-width: 980px) {
    .principles__list {
      grid-template-columns: repeat(2, 1fr);
    }

    article:nth-child(2) {
      border-right: 0;
    }

    article:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }

    article:nth-child(3) {
      padding-left: 0;
    }
  }

  @media (max-width: 720px) {
    .latest {
      grid-template-columns: auto 1fr auto;
      padding: 1rem 0;
    }

    .latest__label {
      grid-column: 2;
      padding-right: 0;
      border-right: 0;
    }

    .latest strong {
      grid-column: 2;
      grid-row: 2;
      white-space: normal;
    }

    .latest__action {
      display: none;
    }

    .latest svg {
      grid-column: 3;
      grid-row: 1 / 3;
    }
  }

  @media (max-width: 560px) {
    .principles__list {
      grid-template-columns: 1fr;
    }

    article,
    article + article {
      padding: 1.5rem 0;
      border-top: 1px solid var(--line);
      border-right: 0;
    }

    article:first-child {
      border-top: 0;
    }
  }
</style>
