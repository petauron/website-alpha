---
import type { CollectionEntry } from "astro:content";
import CenterAgentDiagram from "../ui/CenterAgentDiagram.astro";
import { translations, type Locale } from "../../data/i18n";

interface Props {
  project: CollectionEntry<"projects" | "projectsZh">;
  locale?: Locale;
}

const { project, locale = "en" } = Astro.props;
const text = translations[locale].home;
const projectHref = `${locale === "zh" ? "/zh" : ""}/projects/${project.id}`;
---

<section class="featured">
  <div class="container">
    <div class="featured__plate">
      <div class="featured__content">
        <span class="featured__label">{text.currentProject}</span>
        <h2>{project.data.title}</h2>
        <p>{project.data.description}</p>
        <div class="featured__meta">
          {
            project.data.status && (
              <span class:list={["status", `status--${project.data.status}`]}>
                {translations[locale].status[project.data.status]}
              </span>
            )
          }
          <a class="text-link" href={projectHref}>
            {text.projectDetails}
            <svg aria-hidden="true" fill="none" height="18" viewBox="0 0 18 18" width="18">
              <path
                d="M3.5 9h11M10 4.5 14.5 9 10 13.5"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"></path>
            </svg>
          </a>
        </div>
      </div>
      <div class="featured__diagram">
        <CenterAgentDiagram label={text.structureOverview} locale={locale} />
      </div>
    </div>
  </div>
</section>

<style>
  .featured {
    padding: 1.5rem 0 1.25rem;
  }

  .featured__plate {
    display: grid;
    grid-template-columns: minmax(21rem, 0.76fr) minmax(0, 1.24fr);
    min-height: 16.5rem;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #ffffff;
  }

  .featured__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: clamp(1.5rem, 2.4vw, 2.25rem);
    border-right: 1px solid var(--line);
  }

  .featured__label {
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  h2 {
    margin-top: 0.65rem;
    color: var(--accent);
    font-family: var(--font-display);
    font-size: clamp(3.1rem, 4.2vw, 4.15rem);
    font-weight: 620;
    letter-spacing: 0;
    line-height: 0.95;
  }

  .featured__content > p {
    max-width: 31rem;
    margin-top: 0.75rem;
    color: var(--text);
    font-size: clamp(1.05rem, 1.5vw, 1.22rem);
    line-height: 1.45;
  }

  .featured__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    align-items: center;
    margin-top: 1.1rem;
  }

  .featured__diagram {
    display: grid;
    align-items: center;
    min-width: 0;
    padding: 0.75rem clamp(1rem, 2vw, 2rem);
    background: #f8fbff;
  }

  :global(html[lang="zh"]) .featured__content > p {
    line-height: 1.75;
  }

  @media (max-width: 850px) {
    .featured__plate {
      grid-template-columns: 1fr;
    }

    .featured__content {
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
  }

  @media (max-width: 560px) {
    .featured__plate {
      min-height: auto;
    }

    .featured__diagram {
      padding: 1.25rem 0.5rem;
    }
  }
</style>
