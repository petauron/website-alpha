---
import Button from "../ui/Button.astro";
import { translations, type Locale } from "../../data/i18n";
import { site } from "../../data/site";

interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;
const text = translations[locale].home;
---

<section class="hero">
  <div class="container">
    <h1>{text.heroTitle}</h1>
    <p class="hero__lede">{text.heroCopy}</p>
    <div class="hero__footer">
      <div class="hero__proof">
        <span aria-hidden="true" class="hero__proof-icon">
          <svg fill="none" viewBox="0 0 24 24">
            <path
              d="M12 2.8 20 6v5.4c0 5-3.2 8.4-8 9.8-4.8-1.4-8-4.8-8-9.8V6l8-3.2Z"
              stroke="currentColor"
              stroke-width="1.6"></path>
            <path
              d="m8.6 12 2.1 2.1 4.9-5"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.6"></path>
          </svg>
        </span>
        <p><strong>{text.heroProofTitle}</strong><span>{text.heroProofCopy}</span></p>
      </div>
      <div class="hero__actions">
        <Button href={locale === "zh" ? "/zh/projects" : "/projects"}
          >{text.exploreProjects}</Button
        >
        <Button external href={site.organization} variant="secondary"
          >{text.viewOnGithub}</Button
        >
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 3.5rem 0 0;
  }

  h1 {
    max-width: 1250px;
    margin-left: 1.5rem;
    font-family: var(--font-display);
    font-size: clamp(4rem, 7.7vw, 6rem);
    font-weight: 610;
    letter-spacing: -0.01em;
    line-height: 0.94;
    text-wrap: balance;
  }

  .hero__lede {
    max-width: 68ch;
    margin-top: clamp(1.8rem, 3.6vw, 3rem);
    margin-left: 1.5rem;
    color: var(--text-muted);
    font-size: clamp(1.08rem, 1.7vw, 1.35rem);
    line-height: 1.4;
  }

  .hero__footer {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 3rem;
    align-items: center;
    margin-top: 1.125rem;
    padding: 0.75rem 0 1.75rem;
    border-bottom: 2px solid var(--accent);
  }

  .hero__proof {
    display: flex;
    gap: 1rem;
    align-items: center;
    min-width: 0;
    padding-left: 1.5rem;
  }

  .hero__proof-icon {
    display: grid;
    flex: 0 0 auto;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border-radius: 9px;
    background: var(--accent);
    color: #ffffff;
  }

  .hero__proof-icon svg {
    width: 1.55rem;
    height: 1.55rem;
  }

  .hero__proof p {
    display: grid;
    gap: 0.1rem;
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.45;
  }

  .hero__proof strong {
    color: var(--text);
    font-weight: 600;
  }

  .hero__actions {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: flex-end;
    margin-right: 1.5rem;
  }

  .hero__actions::before {
    position: absolute;
    top: 50%;
    left: -4.5rem;
    width: 1px;
    height: 2.75rem;
    background: var(--line);
    content: "";
    transform: translateY(-50%);
  }

  .hero__actions :global(.button) {
    min-height: 3.35rem;
  }

  .hero__actions :global(.button:first-child) {
    min-width: 15.4rem;
  }

  .hero__actions :global(.button:last-child) {
    min-width: 14.2rem;
  }

  :global(html[lang="zh"]) h1 {
    max-width: 10em;
    font-weight: 670;
    letter-spacing: 0;
    line-height: 1.08;
  }

  :global(html[lang="zh"]) .hero__lede {
    line-height: 1.8;
  }

  @media (max-width: 850px) {
    .hero {
      padding-top: 4rem;
    }

    .hero__footer {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      align-items: start;
    }

    .hero__actions {
      justify-content: flex-start;
      margin-right: 0;
    }

    .hero__actions::before {
      display: none;
    }

    .hero__actions :global(.button:first-child),
    .hero__actions :global(.button:last-child) {
      min-width: 0;
    }
  }

  @media (max-width: 560px) {
    .hero {
      padding-top: 3.25rem;
    }

    h1 {
      margin-left: 0;
      font-size: clamp(3rem, 14.5vw, 4rem);
    }

    .hero__lede,
    .hero__proof {
      margin-left: 0;
      padding-left: 0;
    }

    .hero__actions {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      width: 100%;
      justify-content: stretch;
    }

    .hero__actions :global(.button) {
      width: 100%;
    }
  }
</style>
