---
import { localizePath, translations, type Locale } from "../../data/i18n";
import { navigation } from "../../data/navigation";
import { site } from "../../data/site";
import { socialLinks } from "../../data/social";
import BrandMark from "../ui/BrandMark.astro";
import SocialIcon from "../ui/SocialIcon.astro";

interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;
const pathname = Astro.url.pathname;
const text = translations[locale];
const localePath = (target: Locale) => localizePath(pathname, target);
---

<header class="header">
  <div class="container header__inner">
    <a aria-label={text.accessibility.home} class="brand" href={localizePath("/", locale)}>
      <span
        class="brand__mark"
        title={locale === "zh" ? "品牌标志占位" : "Brand mark placeholder"}
      >
        <BrandMark size={23} />
      </span>
      <span class="brand__name">{site.name}</span>
    </a>
    <nav aria-label={text.accessibility.primaryNavigation} class="nav">
      {
        navigation(locale).map((item) => (
          <a
            aria-current={pathname === item.href ? "page" : undefined}
            class:list={{
              active: pathname === item.href || pathname.startsWith(`${item.href}/`),
            }}
            href={item.href}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="header__actions">
      <nav aria-label={text.language} class="language-switch">
        <a aria-current={locale === "en" ? "page" : undefined} href={localePath("en")}>EN</a>
        <span aria-hidden="true">/</span>
        <a aria-current={locale === "zh" ? "page" : undefined} href={localePath("zh")}>中文</a>
      </nav>
      <nav aria-label={text.accessibility.socialLinks} class="social-links">
        {
          socialLinks.map((link) => (
            <a
              aria-label={link.name}
              data-platform={link.name}
              href={link.href}
              rel="noreferrer"
              target="_blank"
            >
              <SocialIcon name={link.name} size={18} />
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    z-index: 20;
    top: 0;
    border-bottom: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.96);
  }

  .header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 2rem;
    align-items: center;
    min-height: 5.5rem;
  }

  .brand {
    display: inline-flex;
    gap: 0.65rem;
    align-items: center;
    min-height: 2.75rem;
    width: fit-content;
    color: var(--text);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 660;
    letter-spacing: -0.005em;
    text-transform: uppercase;
  }

  .brand__mark {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 1px dashed var(--line-strong);
    border-radius: 6px;
    color: var(--accent);
  }

  .nav {
    display: flex;
    gap: clamp(1.25rem, 2.6vw, 2.5rem);
    align-items: center;
    align-self: stretch;
  }

  .nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.25rem;
    color: var(--link);
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 540;
    transition: color 160ms ease;
  }

  .nav a::after {
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 2px;
    background: transparent;
    content: "";
  }

  .nav a:hover {
    color: var(--link-hover);
  }

  .nav a.active {
    color: var(--accent);
  }

  .nav a.active::after {
    background: var(--accent);
  }

  .header__actions {
    display: flex;
    gap: 1rem;
    justify-self: end;
    align-items: center;
  }

  .language-switch {
    display: inline-flex;
    gap: 0.35rem;
    align-items: center;
    color: var(--text-dim);
    font-family: var(--font-display);
    font-size: 0.76rem;
    font-weight: 570;
  }

  .language-switch a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--link);
    text-decoration: underline transparent;
    text-underline-offset: 0.28em;
    transition:
      color 160ms ease,
      text-decoration-color 160ms ease;
  }

  .language-switch a:hover,
  .language-switch a[aria-current="page"] {
    color: var(--accent);
    text-decoration-color: currentColor;
  }

  .social-links {
    display: inline-flex;
    gap: 0.2rem;
    align-items: center;
    padding-left: 0.75rem;
    border-left: 1px solid var(--line);
  }

  .social-links a {
    display: grid;
    flex: 0 0 2.75rem;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border-radius: 7px;
    color: #64748b;
    transition:
      color 160ms ease,
      background-color 160ms ease;
  }

  .social-links a:hover {
    background: var(--surface);
  }

  .social-links a[data-platform="GitHub"]:hover {
    color: #181717;
  }

  .social-links a[data-platform="X"]:hover {
    color: #000000;
  }

  .social-links a[data-platform="Telegram"]:hover {
    color: #229ed9;
  }

  @media (max-width: 900px) {
    .header__inner {
      grid-template-columns: 1fr auto;
      gap: 0 1rem;
      min-height: auto;
      padding-top: 0.5rem;
    }

    .nav {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-content: center;
      min-height: 3.3rem;
      border-top: 1px solid var(--line);
    }
  }

  @media (max-width: 560px) {
    .header__inner {
      gap: 0 0.5rem;
    }

    .brand {
      gap: 0.45rem;
      font-size: 0.86rem;
    }

    .brand__mark {
      width: 1.8rem;
      height: 1.8rem;
    }

    .header__actions {
      gap: 0.25rem;
    }

    .social-links {
      gap: 0;
      padding-left: 0.25rem;
    }

    .social-links a {
      width: 2.75rem;
      height: 2.75rem;
    }

    .nav {
      gap: clamp(1.35rem, 9vw, 2.4rem);
    }
  }

  @media (max-width: 360px) {
    .brand__name {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
