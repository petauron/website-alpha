---
import { translations, type Locale, type ProjectStatus } from "../../data/i18n";

interface Props {
  title: string;
  description: string;
  status?: "planned" | "development" | "preview" | "stable" | "archived";
  href: string;
  technologies?: string[];
  locale?: Locale;
}

const { title, description, status, href, technologies = [], locale = "en" } = Astro.props;
const displayStatus = status ? translations[locale].status[status as ProjectStatus] : undefined;
---

<a class="project-row" href={href}>
  <span class="project-row__icon" aria-hidden="true">
    <svg fill="none" height="20" viewBox="0 0 20 20" width="20">
      <path
        d="M4 10h12M11 5l5 5-5 5"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.5"></path>
    </svg>
  </span>
  <div class="project-row__main">
    <h3>{title}</h3>
    <p>{description}</p>
  </div>
  {
    (displayStatus || technologies.length > 0) && (
      <div class="project-row__meta">
        {displayStatus && (
          <span class:list={["status", `status--${status}`]}>{displayStatus}</span>
        )}
        {technologies.length > 0 && (
          <span class="project-row__tech">{technologies.join(" · ")}</span>
        )}
      </div>
    )
  }
</a>

<style>
  .project-row {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) auto;
    gap: 1.5rem;
    align-items: center;
    padding: 2rem 1.1rem 2rem 0;
    border-top: 1px solid var(--line);
    color: var(--link);
    transition:
      background-color 180ms ease,
      color 180ms ease;
  }
  .project-row:last-child {
    border-bottom: 1px solid var(--line);
  }
  .project-row:hover {
    background: var(--bg-elevated);
    color: var(--link-hover);
  }
  .project-row__icon {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    color: var(--link);
    transition:
      color 180ms ease,
      transform 180ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .project-row:hover .project-row__icon {
    color: var(--link-hover);
    transform: translateX(3px);
  }
  h3 {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.2vw, 1.8rem);
    font-weight: 590;
    letter-spacing: -0.01em;
  }
  p {
    margin-top: 0.28rem;
    color: var(--text-muted);
    font-size: 1rem;
  }
  :global(html[lang="zh"]) h3 {
    letter-spacing: 0;
  }
  .project-row__meta {
    display: grid;
    gap: 0.55rem;
    justify-items: end;
  }
  .project-row__tech {
    color: var(--text-dim);
    font-size: 0.77rem;
  }
  @media (max-width: 720px) {
    .project-row {
      grid-template-columns: 1.5rem 1fr;
      gap: 0.9rem;
    }
    .project-row__meta {
      grid-column: 2;
      justify-items: start;
    }
    .project-row {
      padding-right: 0;
    }
  }
</style>
