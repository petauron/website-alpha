---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import FeaturedProject from "../../components/sections/FeaturedProject.astro";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  description="Vastora is Petauron's centralized server management platform built on a Center–Agent architecture."
  locale="en"
  title="Product"
>
  <section class="page-hero">
    <div class="container">
      <h1 class="page-hero__title">Product</h1><p class="page-hero__copy">
        Petauron currently has one product: Vastora, a centralized server management platform
        built on a Center–Agent architecture.
      </p>
    </div>
  </section>
  {projects.map((project) => <FeaturedProject locale="en" project={project} />)}
</BaseLayout>
