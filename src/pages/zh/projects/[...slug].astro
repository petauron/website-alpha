---
import { getCollection, render } from "astro:content";
import Button from "../../../components/ui/Button.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { translations } from "../../../data/i18n";

export async function getStaticPaths() {
  const projects = await getCollection("projectsZh");
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const status = project.data.status && translations.zh.status[project.data.status];
---

<BaseLayout description={project.data.description} locale="zh" title={project.data.title}>
  <section class="page-hero">
    <div class="container project-hero">
      {
        status && (
          <span class:list={["status", `status--${project.data.status}`]}>{status}</span>
        )
      }<h1 class="page-hero__title">
        {project.data.title}
      </h1><p class="page-hero__copy">{project.data.description}</p>{
        project.data.repository && (
          <div class="project-hero__action">
            <Button external href={project.data.repository}>
              GitHub 仓库
            </Button>
          </div>
        )
      }
    </div>
  </section>
  <section class="section">
    <div class="container project-body">
      {
        project.data.technologies.length > 0 && (
          <aside>
            <>
              <span>技术</span>
              <ul>
                {project.data.technologies.map((technology) => (
                  <li>{technology}</li>
                ))}
              </ul>
            </>
          </aside>
        )
      }<article class="prose"><Content /></article>
    </div>
  </section>
</BaseLayout>

<style>
  .project-hero .page-hero__title {
    margin-top: 1.25rem;
  }
  .project-hero__action {
    margin-top: 2.2rem;
  }
  .project-body {
    display: grid;
    grid-template-columns: 15rem minmax(0, 1fr);
    gap: clamp(3rem, 8vw, 8rem);
    max-width: 1080px;
  }
  .project-body:not(:has(aside)) {
    display: block;
    max-width: 760px;
  }
  aside {
    padding-top: 1rem;
    border-top: 1px solid var(--accent);
    color: var(--text-dim);
    font-size: 0.75rem;
    font-weight: 720;
    letter-spacing: 0.11em;
  }
  ul {
    display: grid;
    gap: 0.42rem;
    padding: 0.85rem 0 0;
    margin: 0;
    list-style: none;
    color: var(--text-muted);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: normal;
  }
  @media (max-width: 720px) {
    .project-body {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
