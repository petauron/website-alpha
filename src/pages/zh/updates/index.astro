---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";

const updates = (await getCollection("updatesZh")).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
const dateFormat = new Intl.DateTimeFormat("zh-CN", {
  day: "numeric",
  month: "short",
  year: "numeric",
});
const kindLabels = {
  announcement: "公告",
  "development-log": "开发日志",
  release: "发布",
};
---

<BaseLayout description="来自 Petauron 的公告、发布与开发笔记。" locale="zh" title="动态">
  <section class="page-hero">
    <div class="container">
      <h1 class="page-hero__title">动态</h1><p class="page-hero__copy">
        产品公告、发布说明与公开开发动态。
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container updates">
      {
        updates.map((update) => (
          <a class="update" href={`/zh/updates/${update.id}`}>
            <>
              <time datetime={update.data.publishedAt.toISOString()}>
                {dateFormat.format(update.data.publishedAt)}
              </time>
              <div>
                <>
                  <span>{kindLabels[update.data.kind]}</span>
                  <h2>{update.data.title}</h2>
                  <p>{update.data.description}</p>
                </>
              </div>
              <span aria-hidden="true" class="update__arrow">
                <svg fill="none" height="20" viewBox="0 0 20 20" width="20">
                  <path
                    d="M4 10h12M11 5l5 5-5 5"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                  />
                </svg>
              </span>
            </>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .updates {
    max-width: 920px;
  }
  .update {
    display: grid;
    grid-template-columns: 8.5rem 1fr auto;
    gap: 2rem;
    align-items: start;
    padding: 2.2rem 1rem 2.2rem 0;
    border-top: 1px solid var(--line);
    color: var(--link);
    transition:
      background-color 0.18s ease,
      color 0.18s ease;
  }
  .update:last-child {
    border-bottom: 1px solid var(--line);
  }
  .update:hover {
    background: var(--bg-elevated);
    color: var(--link-hover);
  }
  time,
  .update div > span {
    color: var(--text-dim);
    font-size: 0.77rem;
    font-weight: 650;
    letter-spacing: 0.05em;
  }
  h2 {
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-size: 1.55rem;
    font-weight: 560;
    letter-spacing: 0;
  }
  p {
    max-width: 42rem;
    margin-top: 0.55rem;
    color: var(--text-muted);
  }
  .update__arrow {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    color: var(--link);
    transition: transform 180ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .update:hover .update__arrow {
    color: var(--link-hover);
    transform: translateX(3px);
  }
  @media (max-width: 620px) {
    .update {
      grid-template-columns: 1fr auto;
      gap: 1rem;
    }
    .update time {
      grid-column: 1 / -1;
    }
    .update {
      padding-right: 0;
    }
  }
</style>
